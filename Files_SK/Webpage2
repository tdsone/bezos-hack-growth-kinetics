    <script>
        function exportToCSV() {
            const table = document.getElementById('growthTable');
            const rows = table.querySelectorAll('tr');
            let csv = '';
            
            rows.forEach(row => {
                const cols = row.querySelectorAll('th, td');
                const rowData = Array.from(cols).map(col => {
                    let text = col.textContent.replace(/"/g, '""');
                    return `"${text}"`;
                });
                csv += rowData.join(',') + '\\n';
            });
            
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'microbial_growth_data_excel_format.csv';
            a.click();
            window.URL.revokeObjectURL(url);
        }

        function copyToClipboard() {
            const table = document.getElementById('growthTable');
            const rows = table.querySelectorAll('tr');
            let textData = '';
            
            rows.forEach(row => {
                const cols = row.querySelectorAll('th, td');
                const rowData = Array.from(cols).map(col => col.textContent);
                textData += rowData.join('\\t') + '\\n';
            });
            
            navigator.clipboard.writeText(textData).then(() => {
