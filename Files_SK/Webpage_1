    <script>
        function exportToCSV() {
            const table = document.getElementById('growthTable');
            const rows = table.querySelectorAll('tr:not(.paper-header)');
            let csv = '';
            
            // Add header
            const headers = table.querySelectorAll('th');
            const headerRow = Array.from(headers).map(th => `"${th.textContent}"`).join(',');
            csv += headerRow + '\\n';
            
            // Add data rows
            rows.forEach(row => {
                const cols = row.querySelectorAll('td');
                if (cols.length > 0) {
                    const rowData = Array.from(cols).map(col => {
                        let text = col.textContent.replace(/"/g, '""');
                        return `"${text}"`;
                    });
                    csv += rowData.join(',') + '\\n';
                }
            });
            
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'microbial_growth_data.csv';
            a.click();
            window.URL.revokeObjectURL(url);
        }

